# Copy to .env and fill in. The .env file is ignored by git.

# Chat model. Any 'provider:model' string supported by LangChain's init_chat_model.
HORN_STUDY_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Optional per-role overrides.
# HORN_STUDY_RESEARCH_MODEL=
# HORN_STUDY_COORDINATOR_MODEL=
# HORN_STUDY_INTERPRETER_MODEL=

# LangSmith tracing.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=horn-study
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Optional. Without a key, OpenAlex search shares a small daily allowance per network.
# OPENALEX_API_KEY=

# The real evaluator, as 'package.module:attribute'. Needed for evaluation_mode "real".
# The team's evaluator is the backend's hornsim pipeline:
# HORN_STUDY_REAL_EVALUATOR=horn_study.hornsim_evaluator

# hornsim evaluator. See "The hornsim evaluator" in README.md.
# Relative paths are resolved from where the command runs, which is agents/ in these examples.
# The backend directory, with its own environment at backend/.venv.
# HORNSIM_BACKEND_DIR=../backend
# The patient's ear mesh in mm (ear.ply from earrecon, or the template ear).
# HORNSIM_EAR_MESH=../backend/data/template_ear/ear.ply
# Where patient contexts and built aids are kept and reused.
# HORNSIM_WORK_DIR=../backend/data/horn_study
# Optional. The backend interpreter, when it is not <backend>/.venv/bin/python.
# HORNSIM_PYTHON=
# Optional. Rescale the mesh to this ear height in mm.
# HORNSIM_EAR_HEIGHT_MM=
# Optional. Seconds allowed per hornsim step. Defaults to 1800.
# HORNSIM_BRIDGE_TIMEOUT_SECONDS=

# Where studies are saved. Defaults to ./studies.
# HORN_STUDY_DIR=
